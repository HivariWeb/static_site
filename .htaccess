# Generated by tools/prepare-release.py. Check proxy HTTPS behavior before release.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Keep certificate renewal available.
RewriteRule ^\.well-known/acme-challenge/ - [L]
# Never serve working files or server internals over HTTP.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule ^(?:includes|config|tools|tests|docs|audit-[^/]+|backups)(?:/|$) - [F,L,NC]
RewriteRule (?:_snippet\.(?:html|js|css)|\.docx|\.credential\.xml|\.credentials\.xml)$ - [F,L,NC]
# Redirect only safe navigation requests; never forward form bodies to another origin.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{HTTP_HOST} !^www\.dianaberezovskaya\.online$ [NC]
RewriteRule ^ https://www.dianaberezovskaya.online%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://www.dianaberezovskaya.online%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ https://www.dianaberezovskaya.online/ [R=301,L,NE]
</IfModule>

<IfModule mod_headers.c>
Header always unset X-Powered-By
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://mc.yandex.ru https://mc.yandex.com 'sha256-EWwlkcUo0LmuqqDcEBaC0lE3yrMg/85agohgltd87NY='; style-src 'self'; font-src 'self'; img-src 'self' data: https://*.yandex.ru https://*.yandex.com; connect-src 'self' https://*.yandex.ru https://*.yandex.com; frame-src 'none'"
<FilesMatch "\.(?:html|xml|txt)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
